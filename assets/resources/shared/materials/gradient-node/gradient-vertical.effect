CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        alphaThreshold: { value: 0.5 }
        albedoTexture:  { value: grey, editor: { displayName: AlbedoMap } }
        type:           { value: 0.0, editor: { displayName: type } }
        topColor:       { value: [1,1,1,0], editor: { displayName: TopColor } }
        bottomColor:    { value: [1,0,0,0], editor: { displayName: BottomColor } }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
    #else
    pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
    v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision highp float;

  #include <alpha-test>
  #include <texture>

  in vec4 v_color;
  uniform sampler2D albedoTexture;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
  #endif
  uniform GradientUBO
  { 
    mediump vec4 topColor;
    mediump vec4 bottomColor;
    float type;
  };

  void main () {
    vec4 o = vec4(1, 1, 1, 1);
    vec4 o2 = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      CCTexture(texture, v_uv0, o);
    #endif

    if(type == 0.0){
      o.rgb *= ((topColor - bottomColor) * smoothstep(bottomColor.a, topColor.a, 1.0 - v_uv0.y) + bottomColor).rgb;
    } else {
      CCTexture(albedoTexture, v_uv0, o2);
      o *= o2;
    }

    o.a *= v_color.a;

    ALPHA_TEST(o);

    #if USE_BGRA
      gl_FragColor = o.bgra;
    #else
      gl_FragColor = o.rgba;
    #endif
  }
}%
