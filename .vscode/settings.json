{
    "jest.pathToJest": "npm test --",
    "jest.showCoverageOnLoad": false,
    "coverage-gutters.showGutterCoverage": true,
    "coverage-gutters.showLineCoverage": true,
    "sonarlint.analyzerProperties": {},
    "sonarlint.connectedMode.project": {
        "connectionId": "l1-game-client",
        "projectKey": "l1-game-client"
    },
    "coverage-gutters.showRulerCoverage": true,
    "dotupGenerateTestFile.sourceDirectoryName": "assets",
    "dotupGenerateTestFile.testFileLocation": "source file directory",
    // "dotupGenerateTestFile.testFileLocation": "test directory",
    // "dotupGenerateTestFile.testDirectoryName": "__test__",
    "dotupGenerateTestFile.testFileSuffix": "test",
    "dotupGenerateTestFile.template.file": ["${Imports}", "", "${FileTests}"],
    "dotupGenerateTestFile.template.class": [
        "describe('Test class ${ClassName}', () => {",
        "let node :cc.Node;",
        "let comp :${ClassName};",
        "beforeAll(() => {",
        "node = new cc.Node();",
        "comp = node.addComponent(${ClassName});",
        "",
        "});",
        "${ClassTests}",
        "});",
        ""
    ],
    "dotupGenerateTestFile.template.method": [
        "describe('Test method ${MethodName}', () => {",
        "",
        "it('Case: ', () => {",
        "// Arrange",
        "",
        "",
        "// Act",
        "comp.${MethodName}();",
        "",
        "// Assert",
        "",
        "});",
        "",
        "});",
        ""
    ],
    "dotupGenerateTestFile.template.asyncMethod": [
        "describe('Test method ${MethodName}', () => {",
        "",
        "it('Case 1', async () => {",
        "// Arrange",
        "",
        "",
        "// Act",
        "",
        "",
        "// Assert",
        "",
        "});",
        "",
        "});",
        ""
    ],
    "dotupGenerateTestFile.template.function": [
        "it('${ClassName}.${MethodName}()', () => {",
        "// Arrange",
        "",
        "",
        "// Act",
        "",
        "",
        "// Assert",
        "",
        "});",
        ""
    ],
    "dotupGenerateTestFile.template.asyncFunction": [
        "it('${ClassName}.${MethodName}()', async() => {",
        "// Arrange",
        "",
        "",
        "// Act",
        "",
        "",
        "// Assert",
        "",
        "});",
        ""
    ],
    "dotupGenerateTestFile.template.property": [""],
    "typescript.updateImportsOnFileMove.enabled": "always"
}
